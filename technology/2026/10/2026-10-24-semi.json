        {
          "title": "Why is AI generated language so hard to understand?",
          "url": "https://arxiv.org/abs/2610.29162",
          "source": "Hacker News",
          "date": "2026-10-24T18:04:57+00:00",
          "language": "en",
          "section": "us_news",
          "raw_content": "There is a widespread sense that AI-generated text has recently become harder to understand. In this study, we investigate a set of psycholinguistic features that are known to correlate with human processing difficulty (e.g., object relative clauses, long syntactic dependencies, low-frequency n-grams). Using a novel corpus of AI-generated text across diverse domains, we find that AI models use these difficult features more often than paraphrases generated by round-trip translation. Compared with human writing, all nine frontier and near-frontier models use more inanimate subjects with animate",
          "organization": "",
          "arxiv_id": "",
          "link_verified": true,
          "focus_match": [
            "ai"
          ],
          "priority_hint": 7,
          "title_zh": "",
          "summary": "",
          "keywords": [],
          "is_highlight": false
        },
