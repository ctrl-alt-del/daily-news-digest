        {
          "title": "Agentic Retrieval-Augmented Generation for Financial Document Question Answering",
          "title_zh": "面向金融文档问答的智能体检索增强生成",
          "url": "http://arxiv.org/abs/2605.05409v2",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2605.05409",
          "summary": "FinAgent-RAG runs iterative retrieval-reasoning loops with self-verification for financial QA, combining a contrastive retriever, program-of-thought arithmetic and an adaptive strategy router. It reports 76.81%, 78.46% and 74.96% execution accuracy on FinQA, ConvFinQA and TAT-QA, beating the strongest baseline by 5.62-9.32 points while cutting API costs by 41.3% on FinQA.",
