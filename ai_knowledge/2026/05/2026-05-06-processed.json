        {
          "title": "BALAR : A Bayesian Agentic Loop for Active Reasoning",
          "title_zh": "BALAR：用于主动推理的贝叶斯智能体循环",
          "url": "http://arxiv.org/abs/2605.05386v2",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2605.05386",
          "summary": "BALAR is a task-agnostic outer-loop algorithm that maintains a structured belief over latent states and selects clarifying questions by maximizing expected mutual information, without fine-tuning. It beats baselines by 14.6%, 38.5% and 30.5% on detective-case, puzzle and clinical-diagnosis benchmarks, and can be distilled into a Llama-8B questioning policy.",
