        {
          "title": "STRUCTSURVEY: Structured Agentic Retrieval for Automated Survey Paper Generation",
          "title_zh": "STRUCTSURVEY：面向自动综述论文生成的结构化智能体检索",
          "url": "http://arxiv.org/abs/2607.01243v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2607.01243",
          "summary": "STRUCTSURVEY is a hierarchical multi-agent framework that moves structural reasoning from generation to retrieval by dynamically building graph-based representations of entities, relations and topical taxonomies. On a new reference-grounded benchmark of ACL survey papers it improves ROUGE-1 recall by 2.9 points over embedding-only retrieval without reducing precision.",
