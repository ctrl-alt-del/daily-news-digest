        {
          "title": "EVE-Agent: Evidence-Verifiable Self-Evolving Agents",
          "title_zh": "EVE-Agent：证据可验证的自进化智能体",
          "url": "http://arxiv.org/abs/2605.22905v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2605.22905",
          "summary": "EVE-Agent modifies the proposer-solver loop so each generated instance includes a verbatim evidence span, and an evidence verifier rewards spans by their marginal accuracy gain when provided. The approach substantially improves evidence-grounded correctness over prior self-evolving search agents while leaving the backbone, retriever and search tool unchanged.",
