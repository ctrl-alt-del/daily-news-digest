      "items": [
        {
          "title": "FGDM: Reasoning Aware Multi-Agentic Framework for Software Bug Detection using Chain of Thought and Tree of Thought Prompting",
          "title_zh": "FGDM：基于思维链与思维树提示的推理感知多智能体软件缺陷检测框架",
          "url": "http://arxiv.org/abs/2604.24831v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.24831",
          "summary": "FGDM is a four-agent framework that converts source code into a flow graph, identifies erroneous segments and generates repaired code, using chain-of-thought and tree-of-thought prompts and a FAISS vector index of similar past bugs and fixes. Across 100 programs from projects including Ansible, FastAPI, Keras, Pandas and SpaCy, it reports mean Levenshtein-distance reductions of 24.33 for Python and 8.37 for C, with cosine similarities of 0.951 and 0.974.",
          "keywords": [
            {
              "text": "multi-agent framework",
              "domain": "agent-architecture"
            },
            {
              "text": "bug detection",
              "domain": "agent-architecture"
            },
            {
              "text": "flow graph",
              "domain": "ai-knowledge"
            },
            {
              "text": "similar-bug retrieval",
              "domain": "rag-retrieval"
            },
            {
              "text": "tree-of-thought",
              "domain": "cognition-reasoning"
            }
          ],
          "link_verified": true,
          "is_highlight": false
        },
        {
          "title": "Co-Director: Agentic Generative Video Storytelling",
          "title_zh": "Co-Director：智能体式生成视频叙事",
          "url": "http://arxiv.org/abs/2604.24842v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.24842",
          "summary": "Co-Director is a hierarchical multi-agent framework that formulates generative video storytelling as a global optimization problem, using a multi-armed bandit to identify promising creative directions and a local multimodal self-refinement loop to limit identity drift and preserve sequence-level consistency. The authors also introduce GenAD-Bench, a 400-scenario dataset of fictional products for personalized advertising, and report that Co-Director significantly outperforms state-of-the-art baselines.",
          "keywords": [
            {
              "text": "multi-agent framework",
              "domain": "agent-architecture"
            },
            {
              "text": "video storytelling",
              "domain": "agent-architecture"
            },
