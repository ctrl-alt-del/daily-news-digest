        {
          "title": "Procedural Knowledge at Scale Improves Reasoning",
          "title_zh": "大规模程序性知识提升推理能力",
          "url": "http://arxiv.org/abs/2604.01348v3",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.01348",
          "summary": "Reasoning Memory is a retrieval-augmented generation framework for reasoning models that decomposes step-by-step trajectories into self-contained subquestion-subroutine pairs, yielding a datastore of 32 million procedural knowledge entries. Across six math, science and coding benchmarks, it improves over no retrieval by 19.5% and over a compute-matched test-time scaling baseline by 8.9% at a higher inference budget.",
