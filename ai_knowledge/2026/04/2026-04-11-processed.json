        {
          "title": "AITP: Traffic Accident Responsibility Allocation via Multimodal Large Language Models",
          "title_zh": "AITP：基于多模态大语言模型的交通事故责任划分",
          "url": "http://arxiv.org/abs/2604.20878v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.20878",
          "summary": "AITP is a multimodal LLM for traffic accident responsibility allocation that combines multimodal chain-of-thought reasoning with retrieval-augmented generation over traffic regulations, and the authors release DecaTARA, a ten-task benchmark with 67,941 annotated videos and 195,821 question-answer pairs. It reports state-of-the-art results on responsibility allocation, accident detection and accident understanding.",
