        {
          "title": "Think in Sentences: Explicit Sentence Boundaries Enhance Language Model's Capabilities",
          "title_zh": "以句子思考：显式句子边界增强语言模型能力",
          "url": "http://arxiv.org/abs/2604.10135v2",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "DeepSeek",
          "language": "en",
          "arxiv_id": "2604.10135",
          "summary": "The paper inserts delimiters at sentence boundaries in LLM inputs, combining dummy-token insertion with sentence-by-sentence processing during reasoning, and tests in-context learning and supervised fine-tuning from 7B models up to 600B DeepSeek-V3. It reports consistent gains, including up to 7.7% on GSM8K and 12.5% on DROP, and finds sentence awareness reflected in the fine-tuned models' internal representations.",
          "keywords": [
            {
              "text": "sentence boundaries",
              "domain": "context-prompting"
