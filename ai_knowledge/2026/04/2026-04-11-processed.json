        },
        {
          "title": "FAITH: Factuality Alignment through Integrating Trustworthiness and Honestness",
          "title_zh": "FAITH：融合可信度与诚实度的事实性对齐",
          "url": "http://arxiv.org/abs/2604.10189v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.10189",
          "summary": "FAITH maps confidence scores and semantic entropy from LLM outputs into a natural-language knowledge-state quadrant describing trustworthiness and honestness, then fine-tunes with PPO using a reward that combines correctness and uncertainty signals. It adds a retrieval module for external passages and reports improved factual accuracy and truthfulness on four knowledge-intensive benchmarks.",
          "keywords": [
            {
              "text": "factuality alignment",
              "domain": "ai-knowledge"
            },
