        {
          "title": "FashionMV: Product-Level Composed Image Retrieval with Multi-View Fashion Data",
          "title_zh": "FashionMV：面向多视角时尚数据的产品级组合图像检索",
          "url": "http://arxiv.org/abs/2604.10297v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.10297",
          "summary": "FashionMV defines a multi-view composed image retrieval task and releases a dataset with 127K products, 472K multi-view images and over 220K CIR triplets built through an automated multimodal pipeline. Its ProCIR framework combines two-stage dialogue, caption-based alignment and chain-of-thought guidance, and a 0.8B-parameter model outperforms baselines including general-purpose embedding models ten times larger.",
          "keywords": [
            {
              "text": "composed image retrieval",
              "domain": "rag-retrieval"
            },
            {
              "text": "multi-view data",
              "domain": "embeddings-vectors"
