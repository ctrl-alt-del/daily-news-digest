        {
          "title": "CircuitSynth: Reliable Synthetic Data Generation",
          "title_zh": "CircuitSynth：可靠的合成数据生成",
          "url": "http://arxiv.org/abs/2604.10114v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2604.10114",
          "summary": "CircuitSynth is a neuro-symbolic framework that decouples semantic reasoning from surface realization by distilling a teacher LLM's reasoning into a Probabilistic Sentential Decision Diagram that enforces hard logical constraints, with convex optimization for soft distributional goals. It reports 100% schema validity on complex logic puzzles where unconstrained baselines reach 12.4%, and better rare-combination coverage than prior methods.",
          "keywords": [
            {
              "text": "synthetic data",
              "domain": "knowledge-lifecycle"
            },
            {
              "text": "neuro-symbolic",
              "domain": "cognition-reasoning"
