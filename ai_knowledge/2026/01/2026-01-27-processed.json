        {
          "title": "Insight Agents: An LLM-Based Multi-Agent System for Data Insights",
          "title_zh": "Insight Agents：面向数据洞察的 LLM 多智能体系统",
          "url": "http://arxiv.org/abs/2601.20048v2",
          "source": "arXiv",
          "section": "industry_applications",
          "organization": "",
          "language": "en",
          "arxiv_id": "2601.20048",
          "summary": "Insight Agents is a conversational multi-agent data-insight system for e-commerce sellers built on a plan-and-execute paradigm, with a manager agent plus data-presentation and insight-generation workers. It combines out-of-domain detection with BERT-based routing and dynamically injects domain knowledge; the system launched for Amazon sellers in the US and reportedly achieved 90% human-evaluated accuracy with P90 latency below 15 seconds.",
