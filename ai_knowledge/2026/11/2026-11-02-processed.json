        {
          "title": "Recursa: Toward Recursively Self-Improving Foundation Model Systems",
          "title_zh": "Recursa：迈向递归自我改进的基础模型系统",
          "url": "http://arxiv.org/abs/2611.04035v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "DeepSeek",
          "language": "en",
          "arxiv_id": "2611.04035",
          "summary": "Recursa adapts foundation models to unfamiliar domains by bootstrapping a knowledge repository of domain skills, instructions on when to apply them, task memories and reflections, then refining it through recursive self-improvement with parallel learners that validate and merge local improvements. On Harvey LAB's Firm Knowledge benchmark, it raises all-pass rates on held-out tasks from 30.0% to 55.0% with DeepSeek-V4.1-Flash and from 35.0% to 46.0% with Qwen3.8-Flash.",
