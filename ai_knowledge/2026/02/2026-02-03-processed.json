        },
        {
          "title": "Likelihood-Based Reward Designs for General LLM Reasoning",
          "title_zh": "面向通用 LLM 推理的似然奖励设计",
          "url": "http://arxiv.org/abs/2602.03979v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.03979",
          "summary": "The authors systematically compare rewards derived from the probability or log-probability of the reference answer against binary and other baselines for chain-of-thought fine-tuning. They find log-probability rewards are the only variant that performs well across verifiable and non-verifiable settings, matching or beating binary rewards on success rate with better perplexity, while probability-based VeriFree flatlines without a verifier.",
          "keywords": [
            {
              "text": "reward design",
              "domain": "cognition-reasoning"
            },
            {
              "text": "log-probability",
              "domain": "cognition-reasoning"
            },
            {
              "text": "chain-of-thought",
              "domain": "context-prompting"
            },
