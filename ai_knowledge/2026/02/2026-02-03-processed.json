      "items": [
        {
          "title": "FullStack-Agent: Enhancing Agentic Full-Stack Web Coding via Development-Oriented Testing and Repository Back-Translation",
          "title_zh": "FullStack-Agent：通过面向开发的测试与仓库反向翻译增强智能体全栈 Web 编程",
          "url": "http://arxiv.org/abs/2602.03798v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.03798",
          "summary": "FullStack-Agent combines a multi-agent developer with planning, code editing, codebase navigation and bug localization, a self-improving method that back-translates website repositories into training data, and a benchmark testing frontend, backend and database behavior. It reports gains of 8.7%, 38.2% and 15.9% over the previous state of the art on those three test sets, and self-improvement lifts a 30B model by 9.7%, 9.5% and 2.8%.",
          "keywords": [
            {
              "text": "full-stack coding",
              "domain": "agent-architecture"
            },
            {
              "text": "multi-agent system",
              "domain": "agent-architecture"
