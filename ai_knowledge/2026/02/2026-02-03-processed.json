              "text": "inference efficiency",
              "domain": "agent-architecture"
            }
          ],
          "link_verified": true,
          "is_highlight": false
        },
        {
          "title": "Conformal Thinking: Risk Control for Reasoning on a Compute Budget",
          "title_zh": "保形思考：计算预算下推理的风险控制",
          "url": "http://arxiv.org/abs/2602.03814v2",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.03814",
          "summary": "The paper reframes token-budget selection as risk control, adding an upper confidence threshold that stops reasoning when the model is confident and a parametric lower threshold that preemptively stops unsolvable instances. Given a target risk and validation set, distribution-free risk control sets both thresholds, and experiments show compute savings while adhering to the user-specified risk target.",
          "keywords": [
