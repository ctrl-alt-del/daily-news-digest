              "text": "reasoning benchmarks",
              "domain": "evaluation-benchmark"
            }
          ],
          "link_verified": true,
          "is_highlight": false
        },
        {
          "title": "AgentArk: Distilling Multi-Agent Intelligence into a Single LLM Agent",
          "title_zh": "AgentArk：将多智能体智能蒸馏进单一 LLM 智能体",
          "url": "http://arxiv.org/abs/2602.03955v4",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.03955",
          "summary": "AgentArk distills multi-agent debate dynamics into the weights of a single model through three hierarchical strategies: reasoning-enhanced fine-tuning, trajectory-based augmentation and process-aware distillation. The distilled agents keep single-agent inference cost while retaining multi-agent reasoning and self-correction, with reported robustness and generalization gains across reasoning tasks.",
          "keywords": [
            {
              "text": "multi-agent distillation",
              "domain": "agent-architecture"
            },
            {
              "text": "knowledge distillation",
              "domain": "knowledge-lifecycle"
