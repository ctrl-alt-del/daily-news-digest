        {
          "title": "RVR: Retrieve-Verify-Retrieve for Comprehensive Question Answering",
          "title_zh": "RVR：面向全面问答的检索-验证-再检索",
          "url": "http://arxiv.org/abs/2602.18425v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.18425",
          "summary": "RVR is a multi-round retrieve-verify-retrieve framework in which a verifier selects a high-quality subset of candidate documents and later rounds augment the query with verified documents to uncover answers not yet covered. It reports at least 10% relative and 3% absolute gains in complete recall on QAMPARI and consistent gains on QUEST and WebQuestionsSP across base retrievers.",
          "keywords": [
            {
              "text": "multi-round retrieval",
              "domain": "rag-retrieval"
            },
            {
              "text": "verifier",
              "domain": "cognition-reasoning"
            },
            {
              "text": "answer coverage",
              "domain": "evaluation-benchmark"
            },
            {
              "text": "query augmentation",
              "domain": "context-prompting"
            }
          ],
          "link_verified": true,
          "is_highlight": false
        },
        {
          "title": "VIRAASAT: Traversing Novel Paths for Indian Cultural Reasoning",
          "title_zh": "VIRAASAT：探索印度文化推理的新路径",
          "url": "http://arxiv.org/abs/2602.18429v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.18429",
          "summary": "VIRAASAT builds more than 3,200 multi-hop questions from a knowledge graph of over 700 expert-curated Indian cultural artifacts covering 13 attributes across all 28 states and 8 union territories. The authors propose Symbolic Chain-of-Manipulation (SCoM), which trains a model to simulate atomic knowledge-graph manipulations internally and outperforms standard chain-of-thought baselines by up to 20% under supervised fine-tuning.",
          "keywords": [
            {
