              "text": "validation hooks",
              "domain": "evaluation-benchmark"
            }
          ],
          "link_verified": true,
          "is_highlight": false
        },
        {
          "title": "GraphSkill: Documentation-Guided Hierarchical Retrieval-Augmented Coding for Complex Graph Reasoning",
          "title_zh": "GraphSkill：面向复杂图推理的文档引导分层检索增强编码",
          "url": "http://arxiv.org/abs/2603.06620v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2603.06620",
          "summary": "GraphSkill is an agentic hierarchical retrieval-augmented coding framework that traverses technical documentation top-down with early pruning and uses a self-debugging coding agent with automatically generated small test cases to catch logical errors. It also introduces a dataset spanning small-scale, large-scale and composite graph reasoning tasks, and reports higher task accuracy at lower inference cost than baselines.",
          "keywords": [
            {
              "text": "hierarchical retrieval",
              "domain": "rag-retrieval"
            },
            {
              "text": "retrieval-augmented coding",
              "domain": "rag-retrieval"
