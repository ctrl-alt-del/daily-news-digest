        {
          "title": "Decoding ML Decision: An Agentic Reasoning Framework for Large-Scale Ranking System",
          "title_zh": "GEARS：面向大规模排序系统的智能体推理框架",
          "url": "http://arxiv.org/abs/2602.18640v4",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.18640",
          "summary": "GEARS reframes ranking optimization as autonomous discovery inside a programmable experimentation environment, packaging ranking expertise into reusable agent skills and adding validation hooks to filter brittle policies. Experiments across product surfaces show it finds near-Pareto-efficient policies while keeping deployment stable.",
          "keywords": [
            {
              "text": "agentic ranking",
              "domain": "agent-architecture"
            },
            {
              "text": "experimentation environment",
              "domain": "cognition-reasoning"
            },
