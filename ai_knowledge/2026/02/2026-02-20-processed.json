        {
          "title": "Validating Political Position Predictions of Arguments",
          "title_zh": "验证论证的政治立场预测",
          "url": "http://arxiv.org/abs/2602.18351v1",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.18351",
          "summary": "Uses a dual-scale validation framework combining pointwise and pairwise human annotation to predict political positions in argumentative discourse, building a knowledge base of predictions for 23,228 arguments from 30 Question Time debates with 22 language models. Pointwise agreement is moderate (Krippendorff's alpha 0.578), while pairwise validation reaches 0.86 for the best model, supporting graph-based reasoning and RAG over subjective continuous knowledge.",
