        {
          "title": "Learning Query-Aware Budget-Tier Routing for Runtime Agent Memory",
          "title_zh": "面向运行时智能体记忆的查询感知预算分层路由学习",
          "url": "http://arxiv.org/abs/2602.06025v3",
          "source": "arXiv",
          "section": "research_papers",
          "organization": "",
          "language": "en",
          "arxiv_id": "2602.06025",
          "summary": "BudgetMem structures runtime agent memory as modules offered in Low, Mid and High budget tiers, with a lightweight RL-trained router that performs per-query budget-tier routing to balance task performance and construction cost. Across LoCoMo, LongMemEval and HotpotQA it surpasses strong baselines in high-budget settings and yields better accuracy-cost frontiers under tighter budgets, while comparing implementation, reasoning and capacity tiering.",
          "keywords": [
